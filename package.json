{
  "name": "gitbaro",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:install": "tauri build --bundles app && rm -rf /Applications/GitBaro.app && ditto src-tauri/target/release/bundle/macos/GitBaro.app /Applications/GitBaro.app",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@git-diff-view/core": "^0.0.39",
    "@git-diff-view/lowlight": "^0.0.39",
    "@git-diff-view/react": "^0.0.39",
    "@tailwindcss/postcss": "^4.2.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "clsx": "^2.0.0",
    "diff2html": "^3.4.0",
    "i18next": "^25.6.2",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "commit-and-tag-version": "^12.7.3",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "postcss": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
